# PaperGraph Docker 实验性部署环境变量
# Docker 路径尚未完成完整 RAG 验收；当前推荐环境见 docs/ENVIRONMENT.md。
# 复制为根目录 .env，填写本地密钥。不要提交真实 .env。

# ── LLM API (必填) ──
# 支持任何 OpenAI 兼容接口: DeepSeek / OpenAI / 通义千问 / AIHubMix 等
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat

# 如果代理导致 SSL/EOF 错误,设为 1
LLM_DISABLE_PROXY=1

# ── Embedding（启用文档 Dense Retrieval 时必填）──
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v4
EMBED_API_KEY=your-embedding-api-key
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_DIMENSION=1024

# ── Rerank（启用二阶段重排时必填）──
RERANK_PROVIDER=dashscope
RERANK_API_KEY=your-rerank-api-key
RERANK_MODEL_NAME=qwen3-rerank
RERANK_ENDPOINT=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks

# ── 可选: 学术搜索 API ──
NCBI_EMAIL=
NCBI_API_KEY=
OPENALEX_MAILTO=

# ── 可选: Tavily 预搜索 ──
TAVILY_PRESEARCH_ENABLED=false
TAVILY_API_KEY=

# ── JWT 密钥（必填，至少 32 个字符）──
# 示例生成方式：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PAPERGRAPH_JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters

# ── 应用配置 ──
APP_NAME=PaperGraph
DEBUG=false
LOG_LEVEL=INFO

# Docker 容器内路径。Settings 使用 DATA_DIR / DOWNLOADS_DIR，不使用
# PAPERGRAPH_DATA_DIR / PAPERGRAPH_DOWNLOADS_DIR。
DATA_DIR=/app/data
DOWNLOADS_DIR=/app/downloads/papers
RAG_ARTIFACTS_DIR=/app/data/rag_artifacts
RAG_VECTORS_DIR=/app/data/rag_vectors

RAG_EMBEDDING_ENABLED=true
RAG_RERANK_ENABLED=true
RAG_INGEST_WORKER_ENABLED=false
# RAG_DOCLING_ARTIFACTS_PATH=/app/models/docling
# RAG_DEVICE=cpu
