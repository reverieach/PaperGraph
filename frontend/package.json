{
  "name": "papergraph-frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "openapi:export": "node scripts/export-openapi.mjs",
    "openapi:export:live": "curl -sS -f http://127.0.0.1:8000/openapi.json -o ./openapi.json",
    "openapi:types": "openapi-typescript ./openapi.json -o ./src/types/openapi.ts",
    "openapi:gen": "npm run openapi:export && npm run openapi:types",
    "openapi:gen:live": "npm run openapi:export:live && npm run openapi:types"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.0.7",
    "axios": "^1.6.2",
    "d3": "^7.9.0",
    "katex": "^0.16.11",
    "pdfjs-dist": "^4.0.379",
    "vue": "^3.3.8",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/d3": "^7.4.3",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.4.0",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  }
}
